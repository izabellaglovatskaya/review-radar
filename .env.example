# Copy to .env and fill in. Never commit .env.

# Run mode: auto (live if ANTHROPIC_API_KEY is set, otherwise demo), demo or live.
REVIEW_RADAR_MODE=auto

# Anthropic API key (secret). Leave empty to run in demo mode with canned answers.
ANTHROPIC_API_KEY=
# Model used for classification.
ANTHROPIC_MODEL=claude-haiku-5-5
# Second model used by `review-radar eval --compare`.
ANTHROPIC_COMPARE_MODEL=claude-sonnet-5-5

# Telegram bot that sends the daily summary (secret). Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
# Chat that receives the daily summary (secret).
TELEGRAM_CHAT_ID=

# SQLite database file.
DATABASE_PATH=./data/review_radar.db
